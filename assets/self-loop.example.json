{
  "product": "/path/to/product-repo",
  "branch": "loop/s5",
  "protected": ["main", "rewrite"],
  "records": "/path/to/product-loop-records",
  "workDir": "/path/to/scratch/self-loop-work",
  "phase": "S5",
  "purpose": ["docs/FOUNDER-NOTES.md", "docs/PRODUCT.md", "docs/ARCHITECTURE.md"],
  "briefs": {
    "shared": "engines/shared.md",
    "critic": "engines/critic.md",
    "actor": "engines/actor.md",
    "judge": "engines/judge.md",
    "reviewer": "engines/frame-reviewer.md"
  },
  "owns": {
    "critic": ["test/acceptance", "test/acceptance.test.js"],
    "actor": ["src", "test/unit"]
  },
  "agents": {
    "critic": { "runner": "codex", "model": "gpt-5.4", "effort": "high" },
    "actor": { "runner": "claude", "model": "claude-sonnet-4-6", "effort": "high" },
    "judge": { "runner": "codex", "model": "gpt-5.4-pro", "effort": "high" },
    "reviewer": { "runner": "claude", "model": "claude-opus-4-6", "effort": "high" }
  },
  "setup": [["npm", "ci"]],
  "sealed": ["/path/to/product-loop-sealed"],
  "timeoutMin": 120,
  "commitPrefix": "loop(s5)",
  "gates": {
    "suite": "npm test",
    "require": ["github-actions/verify"],
    "remote": "origin"
  },
  "ssot": {
    "repos": {
      "design": "../product-design"
    },
    "entries": [
      {
        "id": "contracts-index",
        "doc": "docs/CONTRACTS.md",
        "repo": "product",
        "watch": ["src/**"],
        "ignore": ["**/*.test.*"],
        "anchors": [
          {
            "name": "protocol-pin",
            "docPattern": "Protocol Pin:\\s*`([0-9a-f]{8,64})`",
            "source": "src/protocol-pin.json",
            "jsonPointer": "/pin"
          }
        ],
        "mode": "same-batch"
      },
      {
        "id": "top-level-architecture",
        "doc": "architecture/OVERVIEW.md",
        "repo": "design",
        "watch": ["src/**"],
        "ignore": ["**/*.test.*"],
        "check": "node scripts/check-architecture-ssot.mjs \"$SELF_LOOP_SSOT_DOC_REPO/$SELF_LOOP_SSOT_DOC\"",
        "mode": "phase-close"
      }
    ]
  }
}
