{
  "product": "/path/to/product-repo",
  "branch": "loop/s5",
  "protected": ["main", "rewrite"],
  "records": "/path/to/product-loop-records",
  "workDir": "/path/to/scratch/self-loop-work",
  "phase": "S5",
  "purpose": ["docs/FOUNDER-NOTES.md", "docs/PRODUCT.md", "docs/ARCHITECTURE.md"],
  "briefs": {
    "shared": "engines/shared.md",
    "critic": "engines/critic.md",
    "actor": "engines/actor.md",
    "judge": "engines/judge.md",
    "reviewer": "engines/frame-reviewer.md"
  },
  "owns": {
    "critic": ["test/acceptance", "test/acceptance.test.js"],
    "actor": ["src", "test/unit"]
  },
  "agents": {
    "critic": { "runner": "codex", "model": "gpt-6.2-sol", "effort": "high" },
    "actor": { "runner": "claude", "model": "claude-opus-5-5", "effort": "high" },
    "judge": { "runner": "codex", "model": "gpt-6.2-astra", "effort": "high" },
    "reviewer": { "runner": "claude", "model": "claude-opus-5-5", "effort": "high" }
  },
  "setup": [["npm", "ci"]],
  "sealed": ["/path/to/product-loop-sealed"],
  "timeoutMin": 120,
  "commitPrefix": "loop(s5)",
  "gates": {
    "suite": "npm test",
    "require": ["github-actions/verify"],
    "remote": "origin"
  }
}
