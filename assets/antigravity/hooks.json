{
  "self-loop": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node '<SELF_LOOP_SCRIPTS>/self-loop.mjs' start --hook antigravity <START_SCOPE_ARGS>",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node '<SELF_LOOP_SCRIPTS>/owner-words.mjs' capture --harness antigravity <WORDS_SCOPE_ARGS>",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node '<SELF_LOOP_SCRIPTS>/lead-guard.mjs' --harness antigravity <GUARD_SCOPE_ARGS>",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node '<SELF_LOOP_SCRIPTS>/word-gate.mjs' --harness antigravity <WORDS_SCOPE_ARGS>",
        "timeout": 15
      }
    ]
  }
}
